# Per-branch LLVM configuration — the ONLY file to edit when starting a new
# release branch. Workflows load these into $GITHUB_ENV (KEY=VALUE lines only).
#
# Release branch example (ocl-open-220):
#   LLVM_MAJOR=22
#   LLVM_MINOR=1
#   LLVM_REF=release/22.x
#   TRANSLATOR_REF=llvm_release_220
#   APT_SUFFIX=-22
LLVM_MAJOR=17
LLVM_MINOR=0
LLVM_REF=release/17.x
TRANSLATOR_REF=llvm_release_170
APT_SUFFIX=-17
